<section class="video-library">
  <div class="video-shell">
    <header class="video-hero">
      <h1 class="video-title gold-gradient-text">Відео-уроки</h1>
      <p class="video-lead">
        Добірка тренувань за напрямками: пілатес, йога, стретчинг, кардіо, силові та мікс-програми.
      </p>
    </header>

    <div class="video-filter-bar" aria-label="Фільтр відеоуроків">
      <button class="video-filter active" type="button" data-video-filter="all">Усі</button>
      <button class="video-filter" type="button" data-video-filter="pilates">Пілатес</button>
      <button class="video-filter" type="button" data-video-filter="yoga">Йога</button>
      <button class="video-filter" type="button" data-video-filter="stretching">Стретчинг</button>
      <button class="video-filter" type="button" data-video-filter="cardio">Кардіо</button>
      <button class="video-filter" type="button" data-video-filter="strength">Силові</button>
      <button class="video-filter" type="button" data-video-filter="mixed">Мікс</button>
    </div>

    <div class="featured-video" data-video-card data-video-category="pilates">
      <button
        class="featured-media video-play-trigger"
        type="button"
        data-video-id="<%= videos.first[:id] %>"
        data-video-title="<%= videos.first[:title] %>"
        aria-label="Дивитися <%= videos.first[:title] %>"
      >
        <img src="https://i.ytimg.com/vi/<%= videos.first[:id] %>/hqdefault.jpg" alt="<%= videos.first[:title] %>">
        <span class="play-badge">Play</span>
        <span class="video-duration"><%= videos.first[:duration] %></span>
      </button>
      <div class="featured-copy">
        <span class="video-chip"><%= videos.first[:category_label] %></span>
        <h2><%= videos.first[:title] %></h2>
        <p>
          Легкий старт для домашнього тренування: коротко, без інвентарю і добре підходить для першого блоку пілатесу.
        </p>
        <button
          class="video-primary-button video-play-trigger"
          type="button"
          data-video-id="<%= videos.first[:id] %>"
          data-video-title="<%= videos.first[:title] %>"
        >
          Дивитися на сайті
        </button>
      </div>
    </div>

    <div class="video-grid">
      <% videos.each do |video| %>
        <article class="yt-card" data-video-card data-video-category="<%= video[:category] %>">
          <button
            class="yt-thumb video-play-trigger"
            type="button"
            data-video-id="<%= video[:id] %>"
            data-video-title="<%= video[:title] %>"
            aria-label="Дивитися <%= video[:title] %>"
          >
            <img src="https://i.ytimg.com/vi/<%= video[:id] %>/hqdefault.jpg" alt="<%= video[:title] %>">
            <span class="video-duration"><%= video[:duration] %></span>
          </button>
          <div class="yt-info">
            <div class="channel-avatar"><%= video[:channel].first %></div>
            <div class="yt-text">
              <h3><%= video[:title] %></h3>
              <p class="yt-channel"><%= video[:channel] %></p>
              <p class="yt-meta"><%= video[:category_label] %> • <%= video[:level] %> • <%= video[:meta] %></p>
            </div>
            <a class="yt-menu" href="<%= video[:url] %>" target="_blank" rel="noopener" aria-label="Відкрити відео на YouTube">...</a>
          </div>
        </article>
      <% end %>
    </div>

    <section class="channel-section">
      <div>
        <p class="video-kicker">YouTube добірка</p>
        <h2 class="channel-title gold-gradient-text">Рекомендовані канали</h2>
      </div>
      <div class="channel-grid">
        <% channels.each do |channel| %>
          <a class="channel-card" href="<%= channel[:url] %>" target="_blank" rel="noopener">
            <span class="channel-avatar channel-avatar-large"><%= channel[:name].first %></span>
            <span>
              <strong><%= channel[:name] %></strong>
              <small><%= channel[:category] %></small>
            </span>
          </a>
        <% end %>
      </div>
    </section>
  </div>
</section>

<div class="video-modal" id="video-modal" aria-hidden="true">
  <div class="video-modal-backdrop" data-video-close></div>
  <div class="video-modal-dialog" role="dialog" aria-modal="true" aria-label="Відеопрогравач">
    <button class="video-modal-close" type="button" data-video-close aria-label="Закрити відео">×</button>
    <div class="video-frame-wrap">
      <iframe
        id="video-modal-frame"
        title="YouTube video player"
        src=""
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
    <h2 id="video-modal-title"></h2>
  </div>
</div>