<div class="exercise-show">
  <p style="color: #d4a356;"><%= notice %></p>
  <%= render @exercise %>
</div>
<div class="exercise-show-links">
  <%= link_to "Редагувати тренування", edit_exercise_path(@exercise), class: "exercise-show-links" %> |
  <%= link_to "Назад до тренувань", exercises_path, class: "exercise-show-links" %>
  <%= button_to "Видалити це тренування", @exercise, method: :delete, class: "button-delete" %>
</div>
