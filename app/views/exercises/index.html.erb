<section class="page-section programs-page">
  <div class="page-shell">
    <header class="page-hero">
      <p class="page-kicker">Training planner</p>
      <h1 class="page-title gold-gradient-text">Програми тренувань</h1>
      <p class="page-lead">
        Обери рівень, плануй тренування в календарі та відмічай дні, коли займаєшся.
        Так легше бачити ритм, не губити прогрес і розуміти, які тренування вже були.
      </p>
    </header>

    <section class="program-level-grid">
      <article class="program-level-card">
        <div class="program-card-top">
          <span class="program-tag">Start</span>
          <span class="program-time">20-30 хв</span>
        </div>

        <h2>Початківець</h2>
        <p>
          М'який вхід у регулярні тренування без перевантаження. Добре підходить,
          якщо ти тільки починаєш або повертаєшся до спорту після паузи.
        </p>

        <dl class="program-stats">
          <div>
            <dt>Частота</dt>
            <dd>3 рази на тиждень</dd>
          </div>
          <div>
            <dt>Фокус</dt>
            <dd>мобільність, легке кардіо, базові рухи</dd>
          </div>
        </dl>

        <ul class="program-plan-list">
          <li>День 1: пілатес або йога</li>
          <li>День 2: легке кардіо</li>
          <li>День 3: full body + розтяжка</li>
        </ul>
      </article>

      <article class="program-level-card">
        <div class="program-card-top">
          <span class="program-tag">Balance</span>
          <span class="program-time">35-50 хв</span>
        </div>

        <h2>Середній</h2>
        <p>
          Збалансований режим для витривалості, форми та кращого тонусу тіла.
          Тут уже можна поєднувати силові, кардіо і відновлення.
        </p>

        <dl class="program-stats">
          <div>
            <dt>Частота</dt>
            <dd>4 рази на тиждень</dd>
          </div>
          <div>
            <dt>Фокус</dt>
            <dd>силові, кардіо, стретчинг, стабільність</dd>
          </div>
        </dl>

        <ul class="program-plan-list">
          <li>2 силові тренування</li>
          <li>1 кардіо або HIIT</li>
          <li>1 йога або стретчинг</li>
        </ul>
      </article>

      <article class="program-level-card">
        <div class="program-card-top">
          <span class="program-tag">Power</span>
          <span class="program-time">50-70 хв</span>
        </div>

        <h2>Просунутий</h2>
        <p>
          Для тих, хто вже має базу і хоче сильнішу структуру з чітким навантаженням.
          Тут важливо чергувати інтенсивність і відновлення.
        </p>

        <dl class="program-stats">
          <div>
            <dt>Частота</dt>
            <dd>5 разів на тиждень</dd>
          </div>
          <div>
            <dt>Фокус</dt>
            <dd>інтенсивність, прогресія, відновлення</dd>
          </div>
        </dl>

        <ul class="program-plan-list">
          <li>3 силові або functional</li>
          <li>1 інтенсивне кардіо</li>
          <li>1 mobility або yoga flow</li>
        </ul>
      </article>
    </section>

    <section class="program-guide">
      <div>
        <p class="page-kicker">Як починати</p>
        <h2 class="section-heading gold-gradient-text">Структура одного тренування</h2>
      </div>

      <div class="guide-steps">
        <div class="guide-step">
          <span>01</span>
          <strong>Розігрів</strong>
          <p>5-8 хв мобільності: шия, плечі, таз, коліна, легкий пульс.</p>
        </div>

        <div class="guide-step">
          <span>02</span>
          <strong>Основний блок</strong>
          <p>15-45 хв за рівнем: пілатес, силові, кардіо або йога.</p>
        </div>

        <div class="guide-step">
          <span>03</span>
          <strong>Заминка</strong>
          <p>5-10 хв спокійної розтяжки та дихання, особливо після кардіо.</p>
        </div>
      </div>
    </section>

    <section class="planner-section">
      <div class="planner-heading">
        <div>
          <p class="page-kicker">Calendar</p>
          <h2 class="section-heading gold-gradient-text">Календар тренувань</h2>
        </div>

        <%= link_to "Додати тренування", new_exercise_path, class: "planner-action" %>
      </div>

      <div class="calendar-panel">
        <%= month_calendar(events: @exercises) do |date, meetings| %>
          <div class="calendar-day-top">
            <span><%= date.day %></span>
            <%= link_to "+", new_exercise_path(date: date), class: "calendar-add", aria: { label: "Додати тренування на #{date.strftime('%d.%m.%Y')}" } %>
          </div>

          <% meetings.each do |meeting| %>
            <%= link_to exercise_path(meeting), class: "program-calendar-event #{meeting.exercise_type}" do %>
              <span><%= Exercise::TYPE_LABELS.fetch(meeting.exercise_type, meeting.exercise_type.titleize) %></span>
              <small><%= meeting.duration %> хв</small>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>
</section>

<%= month_calendar(events: @exercises) do |date, meetings| %>
  <%= date %>
  <% meetings.each do |meeting| %>
    <div>
      <%= meeting.name %>
    </div>
  <% end %>
<% end %>
<div class="exercise-show">
  <p style="color: #d4a356;"><%= notice %></p>
  <% content_for :title, "Тренування" %>
  <div class="exercise-show">
    <h1>Тренування</h1>
  </div>
</div>
<div class="exercise-show-links">
  <% @exercises.each do |exercise| %>
    <%= render exercise %>
    <p>
      <%= link_to "Показати це тренування", exercise,  class: "exercise-show-links" %>
    </p>
  <% end %>
  <%= link_to "Додати нове тренування", new_exercise_path, class: "exercise-show-links"%>
</div>